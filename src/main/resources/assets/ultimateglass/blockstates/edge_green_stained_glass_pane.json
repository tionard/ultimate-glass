{
  "multipart": [
    { "when": { "facing": "north" }, "apply": { "model": "ultimateglass:block/edge_green_stained_glass_pane" } },
    { "when": { "facing": "east" }, "apply": { "model": "ultimateglass:block/edge_green_stained_glass_pane", "y": 90 } },
    { "when": { "facing": "south" }, "apply": { "model": "ultimateglass:block/edge_green_stained_glass_pane", "y": 180 } },
    { "when": { "facing": "west" }, "apply": { "model": "ultimateglass:block/edge_green_stained_glass_pane", "y": 270 } },
    { "when": { "facing": "up" }, "apply": { "model": "ultimateglass:block/edge_green_stained_glass_pane", "x": 90 } },
    { "when": { "facing": "down" }, "apply": { "model": "ultimateglass:block/edge_green_stained_glass_pane", "x": 270 } }
  ]
}
